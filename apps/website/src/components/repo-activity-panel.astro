---
import type { RepoActivity } from '../lib/repo-activity'

interface Props {
  activity: RepoActivity
  /** Espacements resserrés, pour le hero où la hauteur est contrainte */
  compact?: boolean
}

const { activity, compact = false } = Astro.props
const repoUrl = `https://github.com/${activity.owner}/${activity.repo}`

const stats = [
  { value: activity.stars, label: 'étoiles' },
  { value: activity.contributors, label: 'contributeurs' },
  { value: activity.commits30d, label: 'mises à jour ce mois' },
]

// Sparkline : une barre par jour, hauteur relative au jour le plus actif
const peak = Math.max(1, ...activity.daily)
const BAR_W = 3
const GAP = 2
const H = compact ? 22 : 28
const chartW = activity.daily.length * (BAR_W + GAP) - GAP
const hasDaily = activity.daily.some((n) => n > 0)

/** Le volume du jour choisit sa teinte dans la rampe : creux sombres, pics vifs. */
const RAMP = [
  'var(--color-rust-700)',
  'var(--color-rust-600)',
  'var(--color-rust-500)',
  'var(--color-rust-400)',
  'var(--color-rust-300)',
]
function rampColor(count: number): string {
  if (count === 0) return 'var(--color-border)'
  const i = Math.min(RAMP.length - 1, Math.floor((count / peak) * RAMP.length))
  return RAMP[i]
}

const hidden = Math.max(0, activity.contributors - activity.topContributors.length)
const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long' })
---

<div class="min-w-0 overflow-hidden rounded-none border border-border bg-muted/40">
  <div class:list={["flex items-baseline justify-between gap-3 border-b border-border px-5", compact ? "py-2.5" : "py-3"]}>
    <div class="min-w-0">
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-foreground transition-colors hover:text-primary"
      >
        Ferriskey
      </a>
      <p class="mt-0.5 truncate text-[11px] text-muted-foreground">
        Notre plateforme d'identité, développée en public
      </p>
    </div>
    {activity.release && (
      <a
        href={`${repoUrl}/releases/tag/${activity.release.tag}`}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 border border-primary/40 px-1.5 py-1 font-pixel text-[10px] text-primary"
      >
        {activity.release.tag}
      </a>
    )}
  </div>

  <div class:list={["px-5", compact ? "py-4" : "py-5"]}>
    <dl class="flex items-start justify-between gap-4">
      {stats.map((s) => (
        <div class="min-w-0">
          <dd class="font-pixel text-2xl tabular-nums leading-none text-foreground">
            {s.value.toLocaleString('fr-FR')}
          </dd>
          <dt class="mt-1.5 text-[11px] leading-tight text-muted-foreground">{s.label}</dt>
        </div>
      ))}
    </dl>

    <div class:list={[compact ? "mt-4" : "mt-6"]}>
      {hasDaily && (
        <svg
          viewBox={`0 0 ${chartW} ${H}`}
          width="100%"
          height={H}
          preserveAspectRatio="none"
          role="img"
          aria-label={`Activité des ${activity.daily.length} derniers jours : ${activity.commits30d} mises à jour`}
          class="block text-primary"
        >
          {activity.daily.map((count, i) => {
            const h = count === 0 ? 1.5 : Math.max(2.5, (count / peak) * H)
            return (
              <rect
                x={i * (BAR_W + GAP)}
                y={H - h}
                width={BAR_W}
                height={h}
                rx="0"
                fill={rampColor(count)}
                opacity={count === 0 ? 0.5 : 1}
              />
            )
          })}
        </svg>
      )}
      <p class:list={['text-[11px] text-muted-foreground', hasDaily && 'mt-2']}>
        {activity.stale
          ? 'Dernières valeurs connues — API GitHub injoignable au build.'
          : 'Activité des 30 derniers jours'}
      </p>
    </div>

    {activity.topContributors.length > 0 && (
      <div class:list={[compact ? "mt-4 pt-3" : "mt-6 pt-4"]}><div class="pixel-rule mb-4 text-muted-foreground"></div>
        <div class="flex items-center gap-2">
          <div class="flex -space-x-2">
            {activity.topContributors.map((c) => (
              <a
                href={c.profileUrl}
                target="_blank"
                rel="noopener noreferrer"
                title={c.login}
                class="transition-transform hover:z-10 hover:-translate-y-0.5"
              >
                <img
                  src={c.avatarUrl}
                  alt={c.login}
                  width="28"
                  height="28"
                  decoding="async"
                  class="size-7 rounded-full border-2 border-background bg-muted"
                />
              </a>
            ))}
          </div>
          {hidden > 0 && (
            <span class="text-[11px] tabular-nums text-muted-foreground">+{hidden}</span>
          )}
        </div>
        <p class="mt-3 text-[11px] leading-relaxed text-muted-foreground">
          {activity.lastCommitAt ? (
            <>
              Dernière modification{' '}
              <time datetime={activity.lastCommitAt} data-rel>
                le {dateFmt.format(new Date(activity.lastCommitAt))}
              </time>.
            </>
          ) : (
            <>Développé en public depuis mars 2025.</>
          )}
        </p>
      </div>
      </div>
    )}
  </div>
</div>

<script is:inline>
  // Les dates sont rendues en absolu au build (donc exactes quelle que soit la
  // date du déploiement) puis converties en relatif côté client.
  ;(function () {
    var rtf = new Intl.RelativeTimeFormat('fr', { numeric: 'auto' })
    var units = [
      ['year', 31536000],
      ['month', 2592000],
      ['day', 86400],
      ['hour', 3600],
      ['minute', 60],
    ]
    document.querySelectorAll('time[data-rel]').forEach(function (el) {
      var secs = (Date.now() - new Date(el.getAttribute('datetime')).getTime()) / 1000
      if (secs < 60) {
        el.textContent = "à l'instant"
        return
      }
      for (var i = 0; i < units.length; i++) {
        var n = Math.floor(secs / units[i][1])
        if (n >= 1) {
          el.textContent = rtf.format(-n, units[i][0])
          return
        }
      }
    })
  })()
</script>

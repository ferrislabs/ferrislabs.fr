---
import { BackgroundAnimation } from "./background-animation";
import { Icon } from "@iconify/react";
import { Button } from "@explainer/ui";
---

<div
  class="relative px-4 sm:px-6 lg:px-8 flex flex-col py-24 sm:py-32 lg:py-40 pb-0! overflow-hidden"
>
  <div>
    <div class="absolute inset-0 w-full -z-10">
      <BackgroundAnimation client:only="react" />
    </div>

    <!-- Decorative grid -->
    <div
      class="absolute inset-0 -z-5 pointer-events-none"
      style="clip-path: inset(0 -100vw 0 -100vw);"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(to right, var(--color-primary) 1px, transparent 1px), linear-gradient(to bottom, var(--color-primary) 1px, transparent 1px); background-size: 75px 75px; mask-image: radial-gradient(ellipse 75% 65% at 50% 25%, black 0%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 25%, black 0%, transparent 75%);"
      >
      </div>

      <!-- Corner accents -->
      <div class="absolute top-12 left-8 size-3 border border-primary/25 sm:top-16 sm:left-16"></div>
      <div class="hidden sm:block absolute top-20 right-16 size-4 border border-primary/20"></div>
      <div class="hidden sm:block absolute top-1/2 -left-2 size-2.5 border border-primary/20 -translate-y-1/2"></div>
      <div class="hidden sm:block absolute bottom-24 right-1/4 size-3 bg-primary/10"></div>
      <div class="hidden sm:block absolute bottom-16 left-1/3 size-2 bg-primary/10"></div>
    </div>

    <!-- Bottom separator -->
    <div
      class="absolute bottom-0 inset-x-0 h-px bg-linear-to-r from-transparent via-border to-transparent"
    >
    </div>

    <div class="w-full max-w-6xl mx-auto pb-24 lg:pb-32">
      <div class="text-center">
        <div class="mb-6 justify-center animate-fade-up-in">
          <a
            href="https://github.com/ferrislabs"
            rel="noopener noreferrer"
            target="_blank"
            class="rounded-[3px] font-semibold inline-flex items-center gap-2 transition-colors px-4 py-1.5 text-xs ring ring-inset ring-primary/50 text-primary hover:bg-primary/10 active:bg-primary/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <span>FerrisLabs</span>
            <Icon icon="mdi:arrow-right" className="size-3.5" client:load />
          </a>
        </div>
        <h1 class="text-5xl text-pretty tracking-tight text-foreground font-semibold sm:text-7xl max-w-6xl mx-auto animate-fade-up-in animation-delay-100">
          Chez vous, quelque chose est devenu <span class="text-primary">trop lourd</span>. On construit le logiciel qui le <span class="text-primary">simplifie</span>.
        </h1>
        <p class="text-lg sm:text-xl/8 text-muted-foreground text-balance mt-6 max-w-3xl mx-auto animate-fade-up-in animation-delay-200">
          FerrisLabs conçoit des produits sur-mesure, des pipelines d'agents IA en production et des architectures d'identité robustes, avec la même rigueur d'ingénierie qui a donné naissance à Ferriskey, notre plateforme IAM open source. Pas de conseil générique : du code qui tient en production.
        </p>
      </div>

      <div class="pt-10 flex items-center justify-center animate-fade-up-in animation-delay-300">
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-3">
          <Button size="lg" className="cursor-pointer rounded-[3px]" client:load>
            <a
              href="mailto:contact@ferrislabs.fr"
              class="flex gap-2"
            >
              <span>Discutons de votre projet</span>
              <Icon
                icon="mdi:arrow-right"
                aria-hidden="true"
                className="size-5"
                client:load
              />
            </a>
          </Button>
          <Button
            variant="outline"
            size="lg"
            className="cursor-pointer rounded-[3px]"
            client:load
          >
            <a
              href="#ferriskey"
              class="flex gap-2"
            >
              <span>Voir comment on construit</span>
              <Icon
                icon="mdi:arrow-right"
                aria-hidden="true"
                className="size-5"
                client:load
              />
            </a>
          </Button>
        </div>
      </div>

      <div
        class="mt-10 flex items-center justify-center gap-x-8 gap-y-3 flex-wrap animate-fade-up-in animation-delay-400"
      >
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <Icon icon="mdi:open-source-initiative" className="size-4 text-primary/70" client:load />
          <span>Open source par conception</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <Icon icon="mdi:connection" className="size-4 text-primary/70" client:load />
          <span>Propulsé par Ferriskey</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <Icon icon="mdi:language-rust" className="size-4 text-primary/70" client:load />
          <span>Construit autour de Rust</span>
        </div>
      </div>
    </div>
  </div>
</div>

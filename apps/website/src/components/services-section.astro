---
import { Icon } from 'astro-icon/components';
import { Button } from '@explainer/ui/components/button';

const services = [
  {
    icon: "mdi:cube-outline",
    title: "Ingénierie produit",
    description: "Un process manuel qui coûte cher, ou un outil interne que plus personne n'ose toucher. On conçoit et on développe le logiciel qui le remplace, puis on reste pour le faire évoluer.",
    examples: [
      "Applications métier sur-mesure",
      "Automatisation de saisies et de reportings manuels",
      "Reprise d'un outil interne devenu illisible",
      "Intégrations entre logiciels qui ne se parlent pas",
    ],
  },
  {
    icon: "mdi:robot-outline",
    title: "IA appliquée à la production",
    description: "On branche des agents IA sur votre système d'information pour qu'ils exécutent des tâches réelles. Chaque agent a son propre compte, ses propres droits, et on garde une trace de ce qu'il fait.",
  },
  {
    icon: "mdi:shield-key-outline",
    title: "IAM et sécurité",
    description: "Architecture d'identité et de gestion des accès : Keycloak, OIDC, OAuth2. On reprend aussi des installations existantes quand la gestion des droits a dérivé avec le temps. Si NIS2 s'applique chez vous, on en tient compte.",
  },
  {
    icon: "mdi:swap-horizontal",
    title: "Transformation numérique",
    description: "Migration d'outils et modernisation de systèmes existants. On commence par regarder ce qui tourne déjà, souvent une partie mérite d'être gardée telle quelle.",
  },
];
---

<section id="services" class="relative w-full bg-surface-tint py-16 sm:py-24 lg:py-32">
  <div class="relative w-full max-w-6xl mx-auto px-5">
    <div class="max-w-3xl mb-14 reveal">
      <p class="font-pixel text-[12px] uppercase tracking-[0.08em] text-primary mb-4">
        Ce qu'on fait
      </p>
      <h2 class="text-3xl font-semibold text-foreground sm:text-4xl">
        Quatre types de missions
      </h2>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
        On travaille seuls sur un projet complet, ou en renfort d'une équipe déjà en place. La plupart des projets mélangent deux ou trois des sujets ci-dessous.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2 gap-5">
      {services.map((service, index) => (
        <div
          class:list={[
            "border rounded-none bg-primary/5 transition-transform duration-300 hover:-translate-y-1",
            index === 0 ? "lg:col-span-2 lg:row-span-2 relative overflow-hidden" : "",
            index === 1 ? "lg:col-span-2" : "",
          ]}
        >
          {index === 0 && (
            <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
              <div
                class="absolute inset-0 opacity-40"
                style="background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 0%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 0%, transparent 80%);"
              >
              </div>
            </div>
          )}
          <div class:list={["relative flex flex-col h-full", index === 0 ? "p-8 gap-6" : "p-6 gap-4"]}>
            <div
              class:list={[
                "flex items-center justify-center shrink-0 rounded-none bg-rust-600",
                index === 0 ? "size-14" : "size-11",
              ]}
            >
              <Icon name={service.icon} class={index === 0 ? "size-8 text-white" : "size-6 text-white"} />
            </div>
            <div>
              <h3 class:list={["font-semibold text-foreground", index === 0 ? "text-2xl" : "text-base"]}>
                {service.title}
              </h3>
              <p class:list={["text-muted-foreground leading-relaxed", index === 0 ? "text-base mt-3" : "text-sm mt-1.5"]}>
                {service.description}
              </p>
            </div>
            {index === 0 && service.examples && (
              <ul class="flex flex-col gap-2.5">
                {service.examples.map((example) => (
                  <li class="flex items-center gap-2 text-sm text-foreground">
                    <span class="pixel-dot text-primary" aria-hidden="true"></span>
                    <span>{example}</span>
                  </li>
                ))}
              </ul>
            )}
            {index === 0 && (
              <a
                href="#ferriskey"
                class="mt-auto inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
              >
                <span>Voir Ferriskey</span>
                <Icon name="mdi:arrow-right" class="size-3.5" />
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <Button size="lg" className="cursor-pointer rounded-none">
        <a href="mailto:contact@ferrislabs.fr" class="flex gap-2">
          <span>Nous écrire</span>
          <Icon name="mdi:arrow-right" aria-hidden="true" class="size-5" />
        </a>
      </Button>
    </div>
  </div>
</section>

---
import { Icon } from 'astro-icon/components';

const highlights = [
  { icon: "mdi:eye-outline", title: "Vous pouvez lire le code avant de signer", description: "Ferriskey est public sur GitHub. L'architecture, les commits et les discussions techniques sont consultables, y compris les endroits où on s'est trompés." },
  { icon: "mdi:language-rust", title: "Les mêmes outils en mission", description: "Ce qu'on livre est écrit comme Ferriskey : Rust, architecture hexagonale, tests, revue de code." },
  { icon: "mdi:hammer-wrench", title: "On reste après la livraison", description: "Ferriskey continue d'évoluer depuis son lancement, et on applique le même suivi aux projets qu'on développe pour nos clients." },
];
---

<section id="about" class="relative w-full py-16 sm:py-24 lg:py-32">
  <!-- Decorative grid -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style="clip-path: inset(0 -100vw -100vh -100vw);"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(to right, var(--color-primary) 1px, transparent 1px), linear-gradient(to bottom, var(--color-primary) 1px, transparent 1px); background-size: 75px 75px; mask-image: radial-gradient(ellipse 70% 60% at 30% 30%, black 0%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 30% 30%, black 0%, transparent 75%);"
    >
    </div>

    <div class="absolute top-8 right-1/3 size-2.5 border border-primary/20"></div>
  </div>

  <!-- Content -->
    <div class="relative w-full max-w-6xl mx-auto px-5">
      <div class="max-w-3xl mb-14 reveal">
        <p class="font-pixel text-[12px] uppercase tracking-[0.08em] text-primary mb-4">
          Pourquoi nous
        </p>
        <h2 class="text-3xl font-semibold text-foreground sm:text-4xl">
          Notre travail est public
        </h2>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
          FerrisLabs a été fondée par Nathael Bonnal et Baptiste Parmantier, deux ingénieurs logiciels qui travaillent sur des systèmes distribués et des architectures hexagonales en Rust. Le plus simple pour juger notre travail, c'est d'ouvrir le dépôt Ferriskey.
        </p>
      </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {
        highlights.map((item) => (
          <div class="border rounded-none bg-background reveal">
            <div class="bg-primary/5 p-8 flex flex-col gap-5 h-full">
              <div class="flex items-center justify-center size-12 rounded-none bg-rust-600">
                <Icon
                  name={item.icon}
                  class="size-7 text-white"
                />
              </div>
              <div>
                <h3 class="text-xl font-semibold text-foreground">
                  {item.title}
                </h3>
                <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

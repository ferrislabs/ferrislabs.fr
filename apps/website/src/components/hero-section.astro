---
import { PixelSprite } from './pixel/pixel-sprite'
import { cometCrab, crab } from './pixel/sprites'
import { HeroSite } from './hero-site'

/**
 * Le hero : une phrase, le crabe dedans, et en bas un chantier pixel où deux
 * grues posent les blocs et les personnages des produits (hero-site.tsx). Le
 * dernier mot de la phrase change toutes les quelques secondes, lettre par
 * lettre.
 */
const words = ['open source.', 'en Rust.', 'en public.', 'souverain.']
---

<section aria-labelledby="hero-title" class="relative overflow-hidden border-b border-border">
  <div class="hero-scene relative mx-auto flex min-h-[calc(100svh-3rem)] max-w-6xl flex-col items-center border-x border-border px-5 pt-[clamp(3rem,10vh,7rem)] text-center">
    <h1
      id="hero-title"
      class="relative z-10 max-w-4xl text-[clamp(2.5rem,min(7vw,10.5vh),5.5rem)] font-medium leading-[1.02] tracking-[-0.04em] text-foreground"
    >
      <span class="block reveal" style="animation-delay: 0.05s">
        FerrisLabs
        <PixelSprite sprite={crab} className="inline-block size-[0.8em] -translate-y-[0.06em] align-middle" />
        fabrique
      </span>
      <span class="block reveal" style="animation-delay: 0.15s">du logiciel</span>
      <!-- Sa propre ligne : le mot change de longueur sans faire bouger le hero. -->
      <span class="block whitespace-nowrap reveal" style="animation-delay: 0.2s">
        <span id="hero-word" class="inline-block text-primary" aria-live="polite">{words[0]}</span>
      </span>
    </h1>

    <p class="reveal relative z-10 mt-7 max-w-xl text-pretty text-lg leading-8 text-muted-foreground" style="animation-delay: 0.3s">
      Ferriskey, Mestier et FerrisTrace. Trois produits dont tout le code est sur GitHub, du
      premier commit à la mise en production.
    </p>

    <a
      href="https://ferristrace.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="reveal group relative z-10 mt-8 inline-flex items-center gap-3 border border-border bg-card py-1.5 pl-1.5 pr-3 text-sm text-foreground transition-colors hover:bg-foreground/[0.04]"
      style="animation-delay: 0.45s"
    >
      <span class="flex size-7 items-center justify-center bg-indigo-500/10">
        <PixelSprite sprite={cometCrab} className="h-4 w-5" />
      </span>
      <span><span class="font-pixel text-[11px] uppercase text-primary">Nouveau</span> · FerrisTrace, l'observabilité open source</span>
      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>

    <HeroSite client:load />
  </div>
</section>

<style>
  .hero-scene {
    /* Suit aussi la hauteur : le chantier doit tenir dans le premier écran. */
    --u: clamp(40px, min(7vw, 9vh), 88px);
    padding-bottom: calc(var(--u) * 3.1);
  }

  /* Les lettres du mot qui change tombent une à une. */
  :global(.hero-letter) {
    display: inline-block;
    animation: hero-letter 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  @keyframes hero-letter {
    from {
      opacity: 0;
      transform: translateY(-0.6em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero-letter) {
      animation: none;
    }
  }
</style>

<script define:vars={{ words }}>
  function initHeroWord() {
    const el = document.getElementById('hero-word')
    if (!el || el.dataset.ready) return
    el.dataset.ready = '1'
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    let index = 0
    const render = (word) => {
      el.textContent = ''
      ;[...word].forEach((char, i) => {
        const span = document.createElement('span')
        span.className = 'hero-letter'
        span.style.animationDelay = `${i * 0.035}s`
        span.textContent = char === ' ' ? ' ' : char
        el.appendChild(span)
      })
    }
    const timer = setInterval(() => {
      if (!document.body.contains(el)) return clearInterval(timer)
      index = (index + 1) % words.length
      render(words[index])
    }, 2800)
  }

  initHeroWord()
  document.addEventListener('astro:page-load', initHeroWord)
</script>

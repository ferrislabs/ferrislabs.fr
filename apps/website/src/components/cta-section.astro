---
import { Icon } from "@iconify/react";
import { Button } from "@explainer/ui";
---

<div class="w-full max-w-6xl mx-auto px-5 py-16 sm:py-24 lg:py-32">
  <div
    id="technology"
    class="relative overflow-hidden border rounded-[4px] bg-primary/5 px-8 py-16 sm:px-16 sm:py-20 text-center animate-fade-up-in"
  >
    <!-- Decorative grid -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute inset-0 opacity-40"
        style="background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px); background-size: 75px 75px; mask-image: radial-gradient(ellipse 80% 100% at 50% 50%, black 25%, transparent 88%); -webkit-mask-image: radial-gradient(ellipse 80% 100% at 50% 50%, black 25%, transparent 88%);"
      >
      </div>

      <span class="absolute -top-1 -left-1 size-2 border border-primary/40"></span>
      <span class="absolute -top-1 -right-1 size-2 border border-primary/40"></span>
      <span class="absolute -bottom-1 -left-1 size-2 border border-primary/40"></span>
      <span class="absolute -bottom-1 -right-1 size-2 border border-primary/40"></span>

      <div class="absolute top-8 right-1/4 size-2.5 bg-primary/10">
      </div>
      <div
        class="absolute bottom-10 left-[30%] size-2 bg-primary/8"
      >
      </div>
    </div>
    <h2 class="text-3xl font-semibold text-foreground sm:text-4xl">
      Un projet à discuter ?
    </h2>
    <p class="mt-4 text-lg text-muted-foreground max-w-3xl mx-auto text-balance">
      On construit du logiciel sur-mesure, des systèmes d'IA en production et des architectures d'identité robustes. Si vous avez un process trop lourd ou un projet IA sans gouvernance des accès pensée, parlons-en concrètement.
    </p>
    <div class="mt-8 flex justify-center">
      <Button size="lg" className="cursor-pointer rounded-[3px]" client:load>
        <a href="mailto:contact@ferrislabs.fr" class="flex gap-2">
          <span>Discutons de votre projet</span>
          <Icon
            icon="mdi:arrow-right"
            aria-hidden="true"
            className="size-5"
            client:load
          />
        </a>
      </Button>
    </div>
  </div>
</div>

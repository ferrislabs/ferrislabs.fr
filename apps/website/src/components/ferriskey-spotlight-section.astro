---
import { Icon } from 'astro-icon/components';
import { Button } from '@explainer/ui/components/button';
import { BackgroundAnimation } from "./background-animation";

const proofs = [
  {
    icon: "lucide:boxes",
    title: "Architecture",
    description: "Architecture hexagonale en Rust. Le domaine ne dépend d'aucune infrastructure, donc changer de base de données ou de transport ne touche pas la logique métier.",
    grad: "linear-gradient(135deg, var(--color-rust-400), var(--color-rust-500))",
  },
  {
    icon: "lucide:network",
    title: "Distribué",
    description: "Plusieurs services déployés sur Kubernetes. La coordination passe par des événements, et les instances se dupliquent horizontalement.",
    grad: "linear-gradient(135deg, var(--color-rust-500), var(--color-rust-600))",
  },
  {
    icon: "lucide:activity",
    title: "Production",
    description: "CI/CD sur GitHub Actions, métriques Prometheus et logs Loki. Des SLO sont définis sur les services critiques.",
    grad: "linear-gradient(135deg, var(--color-rust-600), var(--color-rust-700))",
  },
];

---

<section id="ferriskey" class="relative py-24 sm:py-32 overflow-hidden">
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style="background: radial-gradient(ellipse at 20% 60%, color-mix(in oklch, var(--color-primary) 8%, transparent) 0%, transparent 60%);"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Eyebrow -->
    <p class="font-pixel text-[12px] uppercase tracking-[0.08em] text-primary">
      Gestion des identités
    </p>

    <!-- Intro -->
    <div class="mt-6 max-w-3xl">
      <div class="flex items-center gap-4">
        <div class="flex items-center justify-center size-14 rounded-none border border-primary/[28%] bg-primary/[12%]">
          <img src="/ferriskey-logo.svg" alt="Ferriskey" class="h-9 w-auto" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl">
            Ferriskey
          </h2>
          <p class="text-sm font-medium mt-0.5 text-primary">
            Plateforme IAM open source, construite en Rust
          </p>
        </div>
      </div>

      <p class="mt-6 text-muted-foreground leading-relaxed">
        Ferriskey est notre plateforme de gestion des identités et des accès. C'est la brique sur laquelle s'appuient nos autres projets, Mestier compris, pour l'authentification et les autorisations. On l'utilise nous-mêmes en production.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button size="default" className="cursor-pointer rounded-none">
          <a href="https://ferriskey.rs" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
            <Icon name="lucide:globe" class="size-4" />
            <span>Voir ferriskey.rs</span>
          </a>
        </Button>
        <Button variant="outline" size="default" className="cursor-pointer rounded-none">
          <a href="https://github.com/ferriskey/ferriskey" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
            <Icon name="mdi:github" class="size-4" />
            <span>Voir sur GitHub</span>
          </a>
        </Button>
      </div>
    </div>

    <!-- Schematic panel: the 3 proofs as connected blocks -->
    <div class="relative mt-12 overflow-hidden rounded-none border border-border bg-background">
      <div class="absolute inset-0 z-0 opacity-30">
        <BackgroundAnimation client:only="react" />
      </div>
      <div
        class="absolute inset-0 z-[1] pointer-events-none opacity-50"
        style="background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px); background-size: 75px 75px; mask-image: radial-gradient(ellipse 92% 100% at 50% 50%, black 35%, transparent 92%); -webkit-mask-image: radial-gradient(ellipse 92% 100% at 50% 50%, black 35%, transparent 92%);"
        aria-hidden="true"
      ></div>

      <div class="relative z-[3] flex flex-wrap items-center justify-center gap-y-5 px-8 py-16 min-h-[280px]">
        {proofs.map((proof, i) => (
          <>
            {i > 0 && (
              <div
                class="relative hidden h-[132px] w-[74px] shrink-0 items-center justify-center sm:flex"
                aria-hidden="true"
              >
                <span class="absolute inset-x-0 top-1/2 -translate-y-1/2 border-t-2 border-dashed border-foreground/45"></span>
                <span class="relative size-2 rotate-45 bg-foreground/70 shadow-sm"></span>
              </div>
            )}
            <div
              class="relative flex h-[132px] w-[210px] max-w-full shrink-0 flex-col justify-between overflow-hidden rounded-none p-4 text-white shadow-lg shadow-primary/20"
              style={`background: ${proof.grad};`}
            >
              <span class="relative z-[1] grid size-10 place-items-center rounded-none" style="background: rgba(255,255,255,0.16);">
                <Icon name={proof.icon} class="size-5 text-white" />
              </span>
              <div class="relative z-[1]">
                <span class="block font-pixel text-[13px] uppercase">
                  {proof.title}
                </span>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Proof descriptions -->
    <dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-none border border-border bg-border sm:grid-cols-3">
      {proofs.map((proof) => (
        <div class="bg-background p-5">
          <dt class="flex items-center gap-2 font-pixel text-[11px] uppercase text-primary">
            <span class="pixel-dot" aria-hidden="true"></span>
            <span>{proof.title}</span>
          </dt>
          <dd class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
            {proof.description}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

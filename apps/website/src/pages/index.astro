---
import Base from '../layouts/base.astro'
import { WebsiteNavbar } from '../components/website-navbar'
import HeroSection from '../components/hero-section.astro'
import TrustedBySection from '../components/trusted-by-section.astro'
import { ManifestoSection } from '../components/manifesto-section'
import { ProductsSection } from '../components/products-section'
import MissionsSection from '../components/missions-section.astro'
import TeamSection from '../components/team-section.astro'
import SiteFooter from '../components/site-footer.astro'
---

<Base
  title="FerrisLabs"
  description="FerrisLabs fabrique du logiciel open source en Rust : Ferriskey pour l'identité, Mestier pour la gestion d'entreprise et FerrisTrace pour l'observabilité. Tout le code est public."
  thumbnail="/thumbnail.png"
>
  <WebsiteNavbar client:load transition:persist />
  <main>
    <HeroSection />
    <TrustedBySection />
    <ProductsSection client:visible />
    <ManifestoSection client:visible />
    <MissionsSection />
    <TeamSection />
  </main>
  <SiteFooter />
</Base>

---
import { Icon } from 'astro-icon/components'
import RepoActivityPanel from './repo-activity-panel.astro'
import { fetchRepoActivity } from '../lib/repo-activity'

// L'activité de Ferriskey, relevée au build : la preuve qu'on construit en public.
const activity = await fetchRepoActivity({
  owner: 'ferriskey',
  repo: 'ferriskey',
  token: import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN,
})

const team = [
  {
    name: 'Nathael Bonnal',
    role: 'Ingénieur logiciel',
    image: '/teams/nathael.jpg',
    description:
      'Direction produit et architecture technique de l\'écosystème Ferris.',
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/nathaelb',
        icon: 'mdi:github',
      },
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/nathael-bonnal',
        icon: 'mdi:linkedin',
      },
    ],
  },
  {
    name: 'Baptiste Parmantier',
    role: 'Ingénieur logiciel',
    image: '/teams/baptiste.jpeg',
    description:
      'Développement et évolution quotidienne des projets FerrisLabs.',
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/LeadcodeDev',
        icon: 'mdi:github',
      },
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/baptiste-parmantier',
        icon: 'mdi:linkedin',
      },
    ],
  },
  {
    name: 'Thibault Pointurier',
    role: 'Ingénieur logiciel',
    image: '/teams/thibault.jpg',
    description: 'Contribue aux projets FerrisLabs, du code jusqu\'au déploiement sur Kubernetes.',
    links: [
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/thibault-pointurier-8a0b64329/',
        icon: 'mdi:linkedin',
      },
    ],
  },
  {
    name: 'Luis Rubiera',
    role: 'CTO Cloud IAM',
    image: '/teams/luis.jpeg',
    description:
      'CTO de Cloud IAM. Conseille l\'écosystème Ferris sur l\'architecture d\'identité et son exploitation à grande échelle.',
    links: [
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/luis-daniel-rubiera-guzman/',
        icon: 'mdi:linkedin',
      },
    ],
  },
]
---

<section id="equipe" aria-labelledby="equipe-title" class="scroll-mt-12 border-b border-border">
  <div class="mx-auto max-w-6xl border-x border-border">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="border-b border-border px-5 py-20 sm:px-8 sm:py-24 lg:border-b-0 lg:border-r">
        <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">Équipe</p>
        <h2
          id="equipe-title"
          class="mt-4 text-balance text-[clamp(2rem,4.5vw,3.5rem)] font-medium leading-[1.05] tracking-[-0.035em]"
        >
          Une petite équipe qui publie tout ce qu'elle écrit.
        </h2>
        <p class="mt-5 max-w-md text-[15px] leading-7 text-muted-foreground">
          FerrisLabs a été fondée par Nathael Bonnal et Baptiste Parmantier. Les dépôts sont publics et les
          contributions extérieures sont les bienvenues : {activity.contributors} personnes ont déjà contribué
          à Ferriskey.
        </p>
      </div>
      <div class="flex items-center px-5 py-10 sm:px-8">
        <div class="w-full">
          <RepoActivityPanel activity={activity} />
        </div>
      </div>
    </div>

    <ul class="grid border-t border-border sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => (
        <li class="group flex flex-col border-b border-border sm:odd:border-r lg:border-b-0 lg:border-r lg:last:border-r-0">
          <div class="relative aspect-[4/5] overflow-hidden border-b border-border bg-muted">
            <img
              src={member.image}
              alt={member.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.03] group-hover:grayscale-0"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <p class="font-pixel text-[10px] uppercase tracking-[0.06em] text-primary">{member.role}</p>
            <h3 class="mt-2 text-lg font-semibold tracking-tight">{member.name}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{member.description}</p>
            <div class="mt-auto flex gap-2 pt-4">
              {member.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${member.name} sur ${link.label}`}
                  class="flex size-9 items-center justify-center border border-border text-muted-foreground transition-colors hover:text-foreground"
                >
                  <Icon name={link.icon} class="size-4" />
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

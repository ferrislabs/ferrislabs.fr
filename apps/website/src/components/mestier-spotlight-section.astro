---
import { Icon } from 'astro-icon/components';
import { Button } from '@explainer/ui/components/button';
import { BackgroundAnimation } from "./background-animation";

const proofs = [
  {
    icon: "mdi:language-rust",
    title: "Rust de bout en bout",
    description: "Backend Axum compilé, sans garbage collector. La latence reste stable quand la charge monte.",
  },
  {
    icon: "mdi:database-check-outline",
    title: "Requêtes vérifiées",
    description: "SQLx contrôle les requêtes PostgreSQL à la compilation. Une colonne renommée casse le build avant d'atteindre la production.",
  },
  {
    icon: "mdi:server-network-outline",
    title: "Auto-hébergeable",
    description: "Un docker compose up suffit pour démarrer, et vos données ne quittent pas vos serveurs.",
  },
];

const modules = [
  { name: "Facturation", icon: "mdi:file-document-outline", status: "Disponible" },
  { name: "CRM", icon: "mdi:account-group-outline", status: "Disponible" },
  { name: "Stock & rentabilité", icon: "mdi:package-variant-closed", status: "Disponible" },
  { name: "Communication d'équipe", icon: "mdi:message-outline", status: "À venir" },
  { name: "Projets", icon: "mdi:view-dashboard-outline", status: "À venir" },
  { name: "Support", icon: "mdi:lifebuoy", status: "À venir" },
  { name: "RH", icon: "mdi:badge-account-outline", status: "À venir" },
];
---

<section
  id="mestier"
  class="relative py-24 sm:py-32 overflow-hidden mestier-theme"
>
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style="background: radial-gradient(ellipse at 80% 40%, color-mix(in oklch, var(--color-primary) 8%, transparent) 0%, transparent 60%);"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Eyebrow -->
    <p class="font-pixel text-[12px] uppercase tracking-[0.08em] text-primary">
      Gestion d'entreprise
    </p>

    <!-- Intro -->
    <div class="mt-6 max-w-3xl">
      <div class="flex items-center gap-4">
        <div class="flex items-center justify-center size-14 rounded-none border border-primary/[28%] bg-primary/[12%]">
          <img src="/mestier-logo.svg" alt="Mestier" class="size-10" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl">
            Mestier
          </h2>
          <p class="text-sm font-medium mt-0.5 text-primary">
            Suite logicielle open source pour l'entreprise, construite en Rust
          </p>
        </div>
      </div>

      <p class="mt-6 text-muted-foreground leading-relaxed">
        Mestier est notre alternative open source à Google Workspace pour les entreprises. La facturation, le CRM et la gestion des stocks fonctionnent aujourd'hui. La communication d'équipe, les projets, le support et les RH suivront. Vous l'hébergez où vous voulez, l'authentification passe par Ferriskey, et le tout est sous licence Apache 2.0.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button size="default" className="cursor-pointer rounded-none">
          <a href="https://mestier.fr" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
            <Icon name="lucide:globe" class="size-4" />
            <span>Voir mestier.fr</span>
          </a>
        </Button>
        <Button variant="outline" size="default" className="cursor-pointer rounded-none">
          <a href="https://github.com/ferrislabs/mestier" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
            <Icon name="mdi:github" class="size-4" />
            <span>Voir sur GitHub</span>
          </a>
        </Button>
      </div>
    </div>

    <!-- Panel: les modules de la suite -->
    <div class="relative mt-12 overflow-hidden rounded-none border border-border bg-background">
      <div class="absolute inset-0 z-0 opacity-30">
        <BackgroundAnimation client:only="react" />
      </div>
      <div
        class="absolute inset-0 z-[1] pointer-events-none opacity-50"
        style="background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px); background-size: 75px 75px; mask-image: radial-gradient(ellipse 92% 100% at 50% 50%, black 35%, transparent 92%); -webkit-mask-image: radial-gradient(ellipse 92% 100% at 50% 50%, black 35%, transparent 92%);"
        aria-hidden="true"
      ></div>

      <div class="relative z-[3] px-6 py-10 sm:px-8 sm:py-12">
        <p class="text-sm font-medium text-muted-foreground">
          Chaque module s'active indépendamment et partage les mêmes clients, produits et comptes.
        </p>

        <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {modules.map((mod) => (
            <li
              class:list={[
                "flex items-center gap-3 rounded-none border bg-background/80 px-4 py-3 backdrop-blur-sm",
                mod.status === "Disponible" ? "border-primary/40" : "border-border border-dashed",
              ]}
            >
              <Icon
                name={mod.icon}
                class={
                  mod.status === "Disponible"
                    ? "size-5 shrink-0 text-primary"
                    : "size-5 shrink-0 text-muted-foreground/60"
                }
              />
              <span
                class:list={[
                  "text-sm font-medium",
                  mod.status === "Disponible" ? "text-foreground" : "text-muted-foreground",
                ]}
              >
                {mod.name}
              </span>
              {mod.status !== "Disponible" && (
                <span class="ml-auto font-pixel text-[10px] uppercase text-muted-foreground/70">
                  À venir
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Proof descriptions -->
    <dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-none border border-border bg-border sm:grid-cols-3">
      {proofs.map((proof) => (
        <div class="bg-background p-5">
          <dt class="flex items-center gap-2 text-sm font-semibold text-foreground">
            <Icon name={proof.icon} class="size-4 text-primary" />
            <span>{proof.title}</span>
          </dt>
          <dd class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
            {proof.description}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .mestier-theme {
    --color-primary: #0f3d36;
    --primary: #0f3d36;
  }

  :global(html.dark) .mestier-theme {
    --color-primary: oklch(0.75 0.14 165);
    --primary: oklch(0.75 0.14 165);
  }
</style>

---
/**
 * Bande « ils nous font confiance ».
 *
 * Les logos ne sont pas mis à la même hauteur : quatre sont des marques
 * carrées (ratio 1,0), Cloud-IAM est un logotype (ratio 4,4). À hauteur
 * égale il occuperait 4,4× plus de surface et écraserait les autres.
 * On l'abaisse donc pour équilibrer la surface optique, pas la hauteur.
 */
/** w/h issus du viewBox de chaque SVG : réserve la place avant chargement. */
const logos = [
  { src: '/logos/france-nuage.svg', alt: 'France Nuage', w: 56, px: 56 },
  { src: '/logos/cloud-iam-light.svg', dark: '/logos/cloud-iam-dark.svg', alt: 'Cloud IAM', w: 172, px: 39 },
  { src: '/logos/anthropic-light.svg', dark: '/logos/anthropic-dark.svg', alt: 'Anthropic', w: 49, px: 49 },
  { src: '/logos/natalia.svg', alt: 'Natalia', w: 56, px: 56 },
  { src: '/logos/gilded-health.svg', alt: 'Gilded Health', w: 63, px: 63 },
]
---

<!-- Une cellule par logo, séparées par des filets, comme une ligne de tableau.
     Les logos qui ont une version sombre la montrent en thème sombre. -->
<section aria-label="Ils nous font confiance" class="border-b border-border">
  <div class="mx-auto max-w-6xl border-x border-border">
    <p class="border-b border-border px-5 py-3 font-pixel text-[11px] uppercase tracking-[0.08em] text-muted-foreground">
      Ils nous font confiance
    </p>
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
      {logos.map((logo) => (
        <li class="flex h-28 items-center justify-center border-b border-r border-border transition-colors hover:bg-foreground/[0.03] lg:border-b-0 [&:nth-child(5n)]:lg:border-r-0">
          <img
            src={logo.src}
            alt={logo.alt}
            width={logo.w}
            height={logo.px}
            class:list={['shrink-0', logo.dark && 'dark:hidden']}
            decoding="async"
          />
          {logo.dark && (
            <img src={logo.dark} alt={logo.alt} width={logo.w} height={logo.px} class="hidden shrink-0 dark:block" decoding="async" />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
